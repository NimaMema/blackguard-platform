# Copy to .env (git-ignored) or export in your shell / systemd unit. Never commit real values.
BLACKGUARD_HOST=127.0.0.1
BLACKGUARD_PORT=8000
BLACKGUARD_DATA_DIR=data
# TLS (required for any non-loopback bind). Create a private cert: python3 start.py tls-selfsigned --ip 192.168.1.50
# BLACKGUARD_TLS_CERT=data/tls/blackguard.crt
# BLACKGUARD_TLS_KEY=data/tls/blackguard.key
# Session lifetime
# BLACKGUARD_SESSION_IDLE_MINUTES=30
# BLACKGUARD_SESSION_ABSOLUTE_HOURS=12
# Fictional demo data on first run (set 0 for a clean production install)
# BLACKGUARD_SEED_DEMO=1
# Store raw log lines (redacted) in addition to normalised fields
# BLACKGUARD_STORE_RAW=0
# Optional local AI analyst via Ollama (loopback only unless BLACKGUARD_ALLOW_REMOTE_OLLAMA=1)
# BLACKGUARD_OLLAMA_URL=http://127.0.0.1:11434
# BLACKGUARD_OLLAMA_MODEL=llama3.1:8b
# Transitional: accept v0.4 shared-token collectors (unverified). Reads data/access.json.
# BLACKGUARD_LEGACY_INGEST=1
